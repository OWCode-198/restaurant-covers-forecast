# Predictive Covers API configuration.
#
# Copy to `.env` and edit. Every value is optional -- the defaults run the
# service against the CSV exports already in this repo, with no credentials.
#
#   cp .env.example .env
#
# Never commit the real `.env`: it holds your Toast client secret.

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# csv   -- read daily covers from a CSV export (the default; no credentials)
# toast -- pull orders live from the Toast API (needs the credentials below)
COVERS_SOURCE=csv

# Used when COVERS_SOURCE=csv. Needs a date column and a covers column; the
# column names are sniffed, so a raw Toast export with "Total guests" works.
COVERS_CSV_PATH=data/processed/covers_daily_clean.csv

# ---------------------------------------------------------------------------
# Toast API
# ---------------------------------------------------------------------------
# You cannot get these as an individual. Two routes, both tied to a restaurant
# or a company:
#
#   1. Standard API Access (read-only, self-service) -- buy it in the Toast
#      Shop with your Toast Web login, then create credential sets yourself in
#      Toast Web under Integrations > Toast API access > Manage credentials.
#      Each set is scoped to specific locations. This is enough for this
#      service, which only ever reads.
#
#   2. Toast Partner Program -- a company applies, is vetted, signs a partner
#      agreement, builds against a sandbox the integrations team issues, and
#      passes a certification review before getting production credentials.
#
# The hostname is issued with your credentials; there is no single public
# sandbox host to guess at.
#
# Once the four values below are filled in:
#
#   python3 scripts/toast_preflight.py             # read-only; checks them
#   python3 scripts/toast_backfill.py --start ...  # resumable history load
#
# Run the preflight first. It fails in a second on a bad credential and says
# which of auth / GUID / orders:read is wrong, where the backfill would just
# fail several hundred times over.
COVERS_TOAST_HOSTNAME=
COVERS_TOAST_CLIENT_ID=
COVERS_TOAST_CLIENT_SECRET=

# The restaurant GUID sent as the Toast-Restaurant-External-ID header.
COVERS_TOAST_RESTAURANT_GUID=

# Leave as-is unless Toast tells you otherwise.
COVERS_TOAST_USER_ACCESS_TYPE=TOAST_MACHINE_CLIENT

# Orders per request. Toast caps this at 100.
COVERS_TOAST_PAGE_SIZE=100
COVERS_TOAST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
COVERS_DB_PATH=data/covers_service.sqlite3

# ---------------------------------------------------------------------------
# Location -- for weather, public holidays and nearby events
# ---------------------------------------------------------------------------
# Left unset, these fall back to .covers_forecast_config.json, so the service
# and the CLI stay in agreement. Set them here to override.
# COVERS_LATITUDE=25.7617
# COVERS_LONGITUDE=-80.1918
# COVERS_TIMEZONE=America/New_York
# COVERS_COUNTRY_CODE=US

# YOUR restaurant's street address -- every deployment must set its own. Do not
# copy another location's address or coordinates; event distances are measured
# from this point, so an inherited origin silently grades every event wrong.
#
# Resolve it once with GET /geocode, then set COVERS_LATITUDE / COVERS_LONGITUDE
# above from the result. A city-level centroid makes "2 miles away" versus
# "8 miles away" meaningless -- for reference, the centroid of Miami sits 4.4
# miles from a restaurant in Coconut Grove, which misweights a nearby event by
# up to 0.29 on a 15-mile radius.
#
# Spell street types out if a lookup fails; abbreviations are expanded
# automatically, but an unusual one may not be.
# COVERS_RESTAURANT_ADDRESS=<your street address, city, state, postal code>

# ---------------------------------------------------------------------------
# Event scoring
# ---------------------------------------------------------------------------
# Optional and free (developer.ticketmaster.com). Without it, nearby ticketed
# events simply are not used as a feature.
# COVERS_TICKETMASTER_API_KEY=

# How far out to look for events. This is also the distance at which an event's
# weight reaches zero: weight = 1 - distance/radius, so an event at the edge
# contributes nothing and one at the door contributes fully.
COVERS_EVENT_RADIUS_MILES=15

# Ceiling on total event pressure, where 1.0 means "a typical event day".
# The model's event coefficient was fitted on a binary 0/1 column, so anything
# far above 1 is extrapolation beyond the fitted range; this bounds it. Raise
# it only once you have continuous event history to justify the extra range.
COVERS_EVENT_PRESSURE_CAP=3.0

# false reverts to the old binary behaviour: any event inside the radius sets
# the feature to 1, ignoring distance and size.
COVERS_EVENT_SCORING_ENABLED=true

# Your state or province. Nationwide sports feeds list venues across the whole
# country, and geocoding every one of them to discover it is 2,000 miles away
# wastes time and gets the geocoder to rate-limit you. This is a cheap coarse
# filter applied BEFORE geocoding; the distance grading still does the precise
# work afterwards. Either "Florida" or "FL" is understood. Blank disables it.
# COVERS_RESTAURANT_REGION=Florida

# --- ESPN (free, no key) ---------------------------------------------------
# Sports fixtures including college games, which Ticketmaster often misses.
# Undocumented, so it can change without notice -- one input among several.
COVERS_ESPN_ENABLED=true

# Comma-separated ESPN league paths. Each costs one request per forecast day,
# so trim this to the leagues that actually play near you. Default:
#   football/nfl,football/college-football,basketball/nba,baseball/mlb,hockey/nhl
# Others: basketball/mens-college-basketball, soccer/usa.1
# COVERS_ESPN_LEAGUES=football/nfl,football/college-football,basketball/nba

# --- Recurring events ------------------------------------------------------
# Calendar facts no ticketing API knows: a weekly market, school terms, an
# annual festival. In this project's own history these are most of the flagged
# event days, so they are often the cheapest accuracy win available.
#
# Set them up interactively (it asks you a few questions per event):
#   python3 scripts/setup_recurring_events.py
# COVERS_RECURRING_EVENTS_PATH=recurring_events.json

# ESPN venues carry no coordinates, so they are geocoded once and cached here.
# Safe to delete; it rebuilds itself.
# COVERS_VENUE_CACHE_PATH=data/venue_geocode_cache.json

# false turns off all weather/holiday/event lookups -- useful offline, in CI,
# or when your CSV already carries weather.
COVERS_ENRICHMENT_ENABLED=true

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Complete days required before the model will fit at all. A few months is
# better than the bare minimum.
COVERS_MIN_TRAINING_DAYS=30

# Recent days held back to self-check accuracy (reported on /forecast).
COVERS_HOLDOUT_DAYS=55
